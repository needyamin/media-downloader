# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll

# Local HTML drafts (keep index.html — project landing page)
*.html
!index.html

# Virtual environments and local env files
.venv/
.venv-wsl/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Tooling and test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
pip-wheel-metadata/
*.egg-info/
.eggs/

# IDE and OS files
.vscode/
.idea/
.cursor/
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Desktop app packaging (Nuitka / PyInstaller / Linux AppImage)
# -----------------------------------------------------------------------------
src/desktop_tools/app/build/
src/desktop_tools/app/dist/

# Nuitka / PyInstaller intermediate folders (e.g. media_download.build, *.dist)
*.build/
*.dist/
*.onefile-build/
*.spec

# -----------------------------------------------------------------------------
# Release outputs (do not commit installers or bundle trees)
# -----------------------------------------------------------------------------
release/windows/
release/linux/

# -----------------------------------------------------------------------------
